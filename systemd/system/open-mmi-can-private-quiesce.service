[Unit]
Description=Open MMI Private CAN Fail-Closed Quiesce
Documentation=https://github.com/open-mmi/open-mmi
Requires=open-mmi-can-namespace.service
After=open-mmi-can-namespace.service
JoinsNamespaceOf=open-mmi-can-namespace.service

[Service]
Type=oneshot
PrivateNetwork=true
EnvironmentFile=/etc/open-mmi/vehicle-config-coordinator.env
ExecStart=/opt/open-mmi/venv/bin/open-mmi-vehicle-config-coordinator quiesce-can-private
UMask=0077
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectClock=true
ProtectControlGroups=true
ProtectHome=read-only
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
ReadWritePaths=/run/open-mmi
RestrictAddressFamilies=AF_NETLINK AF_UNIX
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
CapabilityBoundingSet=CAP_NET_ADMIN CAP_DAC_READ_SEARCH
AmbientCapabilities=
