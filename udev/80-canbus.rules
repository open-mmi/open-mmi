# Default Open MMI CAN provisioning rule.
#
# Physical CAN is never brought up directly from udev. Hotplug first forces the
# controller DOWN and asks the fixed privileged provisioner to move it into the
# private CAN namespace, install both egress barriers, create the one-way RX
# gateway, verify the resulting kernel state, and only then bring physical CAN up.

# Seat 1P reference radio infotainment CAN.
SUBSYSTEM=="net", KERNEL=="can0", ACTION=="add", RUN+="/sbin/ip link set can0 down", TAG+="systemd", ENV{SYSTEMD_WANTS}+="open-mmi-vehicle-can-provision.service"

# Local UI/input support used by Open MMI actions.
KERNEL=="uinput", MODE="0666"
SUBSYSTEM=="backlight", KERNEL=="intel_backlight", GROUP="video", MODE="0664"
